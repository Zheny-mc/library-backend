MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_DBNAME=library_db
MONGODB_USERNAME=admin
MONGODB_PASSWORD=adminpassword

REDIS_HOST=redis
REDIS_PORT=6379
